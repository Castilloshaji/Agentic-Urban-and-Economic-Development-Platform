# Copy to .env and replace the placeholders. .env is gitignored — never commit it.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ernakulam
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j ---
# NEO4J_AUTH is read by the container (format: user/password); keep it consistent
# with NEO4J_USER / NEO4J_PASSWORD, which the Python driver uses.
NEO4J_AUTH=neo4j/changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# --- Agent reasoning backend ---
# Resolved at call time: ANTHROPIC_API_KEY set -> Anthropic API, else Ollama.
# Ollama runs natively on the host, not in Docker.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
